#!/bin/bash
# tg-run - run a heavy command through a machine-wide queue.
#
#   tg-run [--light] [--] <command> [args...]
#
# Heavy runs (default) wait in a FIFO queue; only TEST_GATE_SLOTS of them run
# at once. Light runs skip the queue and only wait while memory is critical.
# The command runs in its own process group; leftovers (jest workers,
# browsers) are killed when it ends or when tg-run is interrupted.
set -u

tg_self=$0
while [ -L "$tg_self" ]; do
  link=$(readlink "$tg_self")
  case "$link" in /*) tg_self=$link ;; *) tg_self=$(dirname "$tg_self")/$link ;; esac
done
TG_ROOT=$(cd "$(dirname "$tg_self")/.." && pwd)
# shellcheck source=../lib/common.sh
. "$TG_ROOT/lib/common.sh"

usage() {
  cat >&2 <<'EOF'
Usage: tg-run [--light] [--] <command> [args...]

  tg-run -- yarn test                 heavy: waits for a free slot
  tg-run --light -- yarn test a.test.ts   light: no queue, waits only if memory is critical
  tg-run -- bash -c 'cd app && yarn test'  compound commands

Environment:
  TEST_GATE_SLOTS=1           heavy runs allowed at the same time
  TEST_GATE_MAX_PRESSURE=2    start only while pressure <= this (1 normal, 2 warn, 4 critical)
  TEST_GATE_MIN_DISK_GB=15    start only with this much free space for swap
  TEST_GATE_MAX_WAIT=0        give up after N seconds of waiting (0 = never), exit 75
  TEST_GATE_REPORT_EVERY=30   seconds between "still waiting" messages
  TEST_GATE_MAX_RUN=7200      stop the command after N seconds of running (0 = never)
  TEST_GATE_KILL_LEFTOVERS=1  kill processes left in the group after the command ends
  TEST_GATE_POLL=2            seconds between queue checks

The command gets no input (stdin is /dev/null).
EOF
  exit 64
}

class=heavy
while [ $# -gt 0 ]; do
  case "$1" in
    --light) class=light; shift ;;
    --heavy) class=heavy; shift ;;
    -h | --help) usage ;;
    --) shift; break ;;
    *) break ;;
  esac
done
[ $# -gt 0 ] || usage

SLOTS=${TEST_GATE_SLOTS:-1}
MAX_PRESSURE=${TEST_GATE_MAX_PRESSURE:-2}
MAX_WAIT=${TEST_GATE_MAX_WAIT:-0}
REPORT_EVERY=${TEST_GATE_REPORT_EVERY:-30}
KILL_LEFTOVERS=${TEST_GATE_KILL_LEFTOVERS:-1}
MAX_RUN=${TEST_GATE_MAX_RUN:-7200}
POLL=${TEST_GATE_POLL:-2}

say() { printf '[test-gate] %s\n' "$*" >&2; }

# node/gate.js sets TEST_GATE_PARENT to the pid of the Node process that
# waits for us. If that process is killed, nobody needs this run any more.
GATE_PARENT=${TEST_GATE_PARENT:-}
unset TEST_GATE_PARENT
parent_gone() { [ -n "$GATE_PARENT" ] && ! kill -0 "$GATE_PARENT" 2>/dev/null; }
leave_if_parent_gone() {
  if parent_gone; then
    say "the program that started this run is gone (pid $GATE_PARENT); leaving the queue"
    cleanup
    exit 143
  fi
}

cmd_text=$(printf '%s ' "$@" | tr '\n' ' ')
cmd_text=${cmd_text% }
my_file=""
child=""
watchdog=""
wait_start=$(tg_now)
my_pstart=$(tg_pstart $$)

# Written to a temp file and renamed, so readers never see a half-written file.
write_info() {
  printf 'pid=%s\npstart=%s\nclass=%s\nsince=%s\ncwd=%s\ncmd=%s\n' \
    "$$" "$my_pstart" "$class" "$(tg_now)" "$PWD" "$cmd_text" >"$1.tmp.$$"
  mv "$1.tmp.$$" "$1"
}

cleanup() {
  tg_mutex_unlock
  [ -n "$watchdog" ] && kill "$watchdog" 2>/dev/null
  [ -n "$child" ] && tg_kill_group "$child"
  [ -n "$my_file" ] && rm -f "$my_file"
  child=""
  my_file=""
}
on_signal() {
  say "interrupted: stopping the command and leaving the queue"
  cleanup
  exit "$1"
}
trap 'on_signal 130' INT
trap 'on_signal 143' TERM
trap 'on_signal 129' HUP
trap cleanup EXIT

running_brief() {
  local f out=""
  for f in "$TG_HOME/slots"/*; do
    [ -f "$f" ] || continue
    out="$out${out:+; }$(tg_describe "$f")"
  done
  printf '%s' "${out:-nothing (waiting for resources)}"
}

# Prints a waiting message on the first poll and then every REPORT_EVERY seconds.
reported_at=-1
report() {
  local waited=$(($(tg_now) - wait_start))
  if [ $reported_at -lt 0 ] || [ $((waited - reported_at)) -ge "$REPORT_EVERY" ]; then
    say "$1 Waited $(tg_fmt_dur $waited). This is expected: keep waiting, do not change, split or bypass this command."
    reported_at=$waited
  fi
  if [ "$MAX_WAIT" -gt 0 ] && [ $waited -ge "$MAX_WAIT" ]; then
    say "GAVE UP after $(tg_fmt_dur $waited) (TEST_GATE_MAX_WAIT=$MAX_WAIT). The command did NOT run. Tell the user; do not run it without tg-run."
    exit 75
  fi
}

# ------------------------------------------------------------------- admission
if [ "$class" = heavy ]; then
  tg_mutex_lock
  n=$(cat "$TG_HOME/seq" 2>/dev/null)
  n=$((${n:-0} + 1))
  echo "$n" >"$TG_HOME/seq"
  my_file="$TG_HOME/queue/$(printf '%010d' "$n")-$$"
  write_info "$my_file"
  tg_mutex_unlock

  while :; do
    tg_mutex_lock
    tg_cleanup_stale
    pos=$(ls "$TG_HOME/queue" | sort | grep -n -- "-$$\$" | cut -d: -f1)
    qlen=$(tg_count_files "$TG_HOME/queue")
    free="" nfree=0 i=1
    while [ $i -le "$SLOTS" ]; do
      [ -e "$TG_HOME/slots/$i" ] || { free="$free $i"; nfree=$((nfree + 1)); }
      i=$((i + 1))
    done
    block=""
    if [ "${pos:-1}" -le "$nfree" ]; then
      block=$(tg_block_reason "$MAX_PRESSURE")
      if [ -z "$block" ]; then
        slot=$(echo $free | tr ' ' '\n' | sed -n "${pos:-1}p")
        rm -f "$my_file"
        my_file="$TG_HOME/slots/$slot"
        write_info "$my_file"
        tg_mutex_unlock
        break
      fi
    fi
    tg_mutex_unlock
    if [ -n "$block" ]; then
      report "WAITING: $block."
    else
      report "QUEUED: position $pos of $qlen. Running now: $(running_brief)."
    fi
    sleep "$POLL"
    leave_if_parent_gone
  done
  say "RUNNING (slot $slot of $SLOTS, waited $(tg_fmt_dur $(($(tg_now) - wait_start)))): $cmd_text"
else
  my_file="$TG_HOME/light/$$"
  write_info "$my_file"
  while :; do
    block=$(tg_block_reason 2)
    [ -z "$block" ] && break
    report "WAITING (light run): $block."
    sleep "$POLL"
    leave_if_parent_gone
  done
fi

# ------------------------------------------------------------------------- run
run_start=$(tg_now)
# Job control gives the command its own process group (pgid = $child).
# stdin is /dev/null: a background group that reads from the terminal would
# be stopped (SIGTTIN) and hold the slot forever.
# TEST_GATE_INSIDE tells node/gate.js that this run already has its place.
# Also remove the gate from NODE_OPTIONS: some tools (turbo) do not pass
# all env vars to their tasks, and a gated task would wait for us forever.
export TEST_GATE_INSIDE=1
if [ -n "${NODE_OPTIONS:-}" ]; then
  NODE_OPTIONS=$(tg_strip_gate "$NODE_OPTIONS")
  export NODE_OPTIONS
fi
set -m
env "$@" </dev/null &
child=$!
set +m
# Record the group so a later tg-run can clean it up if we are killed with -9.
echo "pgid=$child" >>"$my_file"

if [ "$MAX_RUN" -gt 0 ] || [ -n "$GATE_PARENT" ]; then
  (
    # Sleep in short steps and stop if tg-run itself is gone (kill -9),
    # so the watchdog never outlives tg-run and hits an unrelated group.
    parent=$$
    end=$(($(tg_now) + MAX_RUN))
    while [ "$MAX_RUN" -le 0 ] || [ "$(tg_now)" -lt $end ]; do
      sleep 2
      kill -0 "$parent" 2>/dev/null || exit 0
      if parent_gone; then
        kill -TERM "$parent" # tg-run stops the command and frees the slot
        exit 0
      fi
    done
    printf '[test-gate] TIMEOUT: the command ran longer than %s (TEST_GATE_MAX_RUN), stopping it\n' "$(tg_fmt_dur "$MAX_RUN")" >&2
    tg_kill_group "$child"
  ) &
  watchdog=$!
fi

wait "$child"
rc=$?
[ -n "$watchdog" ] && kill "$watchdog" 2>/dev/null
watchdog=""

left=$(tg_group_count "$child")
if [ "$left" -gt 0 ]; then
  if [ "$KILL_LEFTOVERS" = 1 ]; then
    say "cleaning up $left leftover process(es) of this run (workers, browsers, servers)"
    tg_kill_group "$child"
  else
    say "warning: $left process(es) of this run are still alive (TEST_GATE_KILL_LEFTOVERS=0)"
  fi
fi
child=""
rm -f "$my_file"
my_file=""

dur=$(($(tg_now) - run_start))
waited=$((run_start - wait_start))
say "DONE in $(tg_fmt_dur $dur) (exit $rc)"

runs="$TG_LOGS/runs.csv"
[ -f "$runs" ] || echo 'started,class,waited_s,duration_s,exit,cwd,cmd' >"$runs"
printf '%s,%s,%s,%s,%s,%s,%s\n' "$(date -r "$run_start" '+%Y-%m-%dT%H:%M:%S' 2>/dev/null || date -d "@$run_start" '+%Y-%m-%dT%H:%M:%S')" \
  "$class" "$waited" "$dur" "$rc" "$(printf '%s' "$PWD" | tr ',' '_')" "$(printf '%s' "$cmd_text" | tr ',' ' ')" >>"$runs"

exit $rc
